# SQLite file for local development. For Postgres later, change the
# datasource provider in prisma/schema.prisma and point this at your database.
DATABASE_URL="file:./dev.db"

# "mock" (default) returns realistic sample data. "claude" sends each upload to
# the Claude API; it needs ANTHROPIC_API_KEY and falls back to mock without it.
EXTRACTOR_MODE="mock"
ANTHROPIC_API_KEY=""
# Optional override of the model used by the claude extractor.
CLAUDE_MODEL="claude-opus-5-5"

# Freezes "today" so the demo numbers match the seeded week (Nov 9–13, 2026).
# Remove it to use the real date.
DEMO_TODAY="2026-11-13"

# Where uploaded files are kept on disk (local storage driver).
STORAGE_DIR="./storage"

# Seconds each fake agent step takes, so you can watch the status change.
AGENT_STEP_SECONDS="2"
